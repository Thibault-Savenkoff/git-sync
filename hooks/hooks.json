{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git pull --ff-only >/dev/null 2>&1; fi; true",
            "commandWindows": "if ((git rev-parse --is-inside-work-tree) 2>$null) { git pull --ff-only *> $null }",
            "timeout": 15,
            "statusMessage": "Syncing repo (git pull)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-sync.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%CLAUDE_PLUGIN_ROOT%\\hooks\\stop-sync.ps1\"",
            "timeout": 15,
            "statusMessage": "Syncing repo (commit + push)..."
          }
        ]
      }
    ]
  }
}
